# Скопируй в /etc/cursoros/config.env и поправь значения.
# cp vds/config.env.example /etc/cursoros/config.env

# Пользователь, под которым крутится desktop (должен существовать)
CURSOROS_USER=ubuntu

# Дисплей / порты
DISPLAY=:1
VNC_PORT=5901
NOVNC_PORT=6080

# Разрешение как у Cloud Agent
GEOMETRY=1920x1200
DEPTH=24
DPI=96
DESKTOP_NAME=CursorOS

# VNC слушает только localhost (доступ снаружи — через SSH-туннель или noVNC)
VNC_LOCALHOST=yes

# Обязательный пароль VNC (Forced login). Не оставляй пустым.
# Задаётся интерактивно установщиком, либо заранее:
#   sudo -u $CURSOROS_USER vncpasswd
# VNC_PASSWORD=  # не храни в git; установщик спросит сам
