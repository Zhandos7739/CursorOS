[Unit]
Description=CursorOS TigerVNC (XFCE) — password required
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=CURSOROS_USER_PLACEHOLDER
Group=CURSOROS_USER_PLACEHOLDER
PAMName=login
Environment=HOME=/home/CURSOROS_USER_PLACEHOLDER
Environment=USER=CURSOROS_USER_PLACEHOLDER
EnvironmentFile=-/etc/cursoros/config.env
WorkingDirectory=/home/CURSOROS_USER_PLACEHOLDER

# Убиваем старый display, если остался
ExecStartPre=-/usr/bin/tigervncserver -kill ${DISPLAY}
ExecStartPre=/bin/mkdir -p /home/CURSOROS_USER_PLACEHOLDER/.vnc
ExecStartPre=/bin/bash -c 'test -f /home/CURSOROS_USER_PLACEHOLDER/.vnc/passwd || { echo "ERROR: нет VNC-пароля. Запусти: sudo -u CURSOROS_USER_PLACEHOLDER vncpasswd"; exit 1; }'

# Forced auth: VncAuth only (НЕ SecurityTypes None)
ExecStart=/usr/bin/tigervncserver ${DISPLAY} \
  -geometry ${GEOMETRY} \
  -depth ${DEPTH} \
  -dpi ${DPI} \
  -rfbport ${VNC_PORT} \
  -localhost \
  -desktop ${DESKTOP_NAME} \
  -SecurityTypes VncAuth \
  -xstartup /home/CURSOROS_USER_PLACEHOLDER/.vnc/xstartup

ExecStop=/usr/bin/tigervncserver -kill ${DISPLAY}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
